# Visual Studio and .NET build output
.vs/
[Bb]in/
[Oo]bj/
TestResults/
artifacts/

# User-specific IDE state
*.user
*.userosscache
*.suo
*.userprefs
*.csproj.user
*.sln.docstates
*.DotSettings.user
_ReSharper*/

# Local secrets and diagnostics
.env
.env.*
