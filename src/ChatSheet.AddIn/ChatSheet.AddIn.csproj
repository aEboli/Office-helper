<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- AnyCPU 是硬要求：同一个程序集需要被 32 位或 64 位的 Microsoft Excel 加载。 -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ChatSheet.AddIn</RootNamespace>
    <AssemblyName>ChatSheet.AddIn</AssemblyName>
    <AssemblyTitle>Office-helper 表格 AI 助手</AssemblyTitle>
    <Product>Office-helper</Product>
    <Version>0.10.3.16</Version>
    <!-- 只对入口类和窗格类显式开放 COM，不整体导出程序集。 -->
    <ComVisible>false</ComVisible>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- 注册由 scripts/install.ps1 直接写 HKLM 的两个 Classes 视图，不依赖 regasm；预构建发布包安装端无需 SDK。 -->
    <RegisterForComInterop>false</RegisterForComInterop>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <!-- net48 无 System.Text.Json；消息桥与四种 API 协议都要处理任意形状的 JSON。 -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Tomlyn" Version="0.20.0" />
    <PackageReference Include="HttpToSocks5Proxy" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <!-- 工具层与协议层是 internal，测试程序需要访问它们做真实验证。 -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ChatSheet.ToolTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ChatSheet.PaneHarness</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ChatWord.AddIn</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Ribbon.xml" />
    <EmbeddedResource Include="Resources\PanelLogo.png" />
    <EmbeddedResource Include="Resources\RibbonSettings.png" />
    <EmbeddedResource Include="Resources\RibbonDiagnose.png" />
    <EmbeddedResource Include="Resources\RibbonFit.png" />
    <EmbeddedResource Include="Resources\RibbonUndo.png" />
    <None Include="Resources\PanelLogo.svg" />
  </ItemGroup>

  <!-- 侧边栏 UI 是静态文件，随生成目录一起部署，运行时用 WebView2 虚拟主机映射加载，不起 HTTP 服务。 -->
  <ItemGroup>
    <None Include="..\web\**\*" LinkBase="web" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
